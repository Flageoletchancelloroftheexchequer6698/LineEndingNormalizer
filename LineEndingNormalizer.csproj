<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LineEndingNormalizer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Single authoritative version source: AssemblyVersion, AssemblyFileVersion, and
         AssemblyInformationalVersion are all derived from this by the SDK. Keep this,
         app.manifest's assemblyIdentity version, and the release tag in agreement. -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      LineEndingNormalizer.Tests lives in a subdirectory of this project.
      SDK-style implicit globbing (**/*.cs) would otherwise sweep its
      source (and generated obj/ files) into this project's own compile.
    -->
    <Compile Remove="LineEndingNormalizer.Tests\**\*.cs" />
    <None Remove="LineEndingNormalizer.Tests\**\*" />
    <Content Remove="LineEndingNormalizer.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
    <PackageReference Include="UTF.Unknown" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LineEndingNormalizer.Tests" />
  </ItemGroup>

</Project>
